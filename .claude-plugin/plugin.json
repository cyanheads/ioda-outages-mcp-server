{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "ioda-outages-mcp-server",
  "version": "0.3.0",
  "description": "Investigate Internet outages with IODA events, alerts, and connectivity signals via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/ioda-outages-mcp-server#readme",
  "repository": "https://github.com/cyanheads/ioda-outages-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "typescript", "bun", "stdio", "streamable-http", "ioda", "internet-outages", "internet-shutdowns", "internet-measurement", "bgp", "connectivity"],
  "mcpServers": {
    "ioda-outages-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/ioda-outages-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
